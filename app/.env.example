# ============================================================
# app/.env.example
# Copiar a app/.env y ajustar para desarrollo local.
# NO subir app/.env al repositorio.
# ============================================================

# Flask
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=dev-only-change-me
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

# PostgreSQL
# En docker compose el host es "db"; fuera de compose usar "localhost".
DATABASE_URL=postgresql://gtn:gtn@db:5432/gtn
# Alternativa local sin Docker:
# DATABASE_URL=postgresql://gtn:gtn@localhost:5432/gtn
POSTGRES_DB=gtn
POSTGRES_USER=gtn
POSTGRES_PASSWORD=gtn

# Reglas de negocio
LAST_MINUTE_HOURS=24
CANCEL_DEADLINE_HOURS=2
DEFAULT_SLOT_MINUTES=120
DEFAULT_MAX_HOURS=4
CSRF_ENABLED=1

# AWS / SNS
# En local se puede dejar vacío: la app registra la notificación sin enviar correo.
AWS_REGION=us-east-1
SNS_TOPIC_ARN=
# En AWS se usa el rol de la instancia. NO poner access keys aquí.

# Servidor
GUNICORN_WORKERS=2
LOG_LEVEL=INFO
SESSION_COOKIE_SECURE=0

# Datos semilla SOLO para demo/local.
# En AWS cambiar estas contraseñas o no usar los usuarios semilla.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_DOCENTE_EMAIL=docente@example.com
SEED_DOCENTE_PASSWORD=Docente1234!
SEED_ESTUDIANTE_EMAIL=estudiante@example.com
SEED_ESTUDIANTE_PASSWORD=Estudiante1234!
